# ~/.cline/cline.op.env — environment for launching VS Code / Cline CLI with injected credentials:
#   op run --env-file ~/.cline/cline.op.env -- code .        (VS Code extension, both builds)
#   Cline CLI: use the `cline` wrapper in ~/.cline/cline-aliases.sh instead — `op run` pipes stdout
#   through its secret masker, so the CLI's TUI fails with "interactive mode requires a TTY".
# Providers read these when no key is stored in providers.json — keep providers.json key-free.
# Every model (subagents included) uses the openai-compatible provider → Agentgateway, which reads its key
# from OPENAI_API_KEY; architect/security use the gateway's openrouter/* passthrough.
OPENAI_API_KEY=op://private/agent-gateway-api-key/password
# Legacy build only: command deny list (deny wins; no allow list, so everything else still prompts).
CLINE_COMMAND_PERMISSIONS={"deny":["rm -rf /*","rm -rf ~*","sudo rm *","git push*","git reset --hard*","terraform destroy*","tofu destroy*","*-auto-approve*","kubectl delete namespace*","kubectl delete ns*","docker system prune*","op read*","op item get*","gh auth token*","printenv*","dd *","mkfs*","diskutil erase*","csrutil *"],"allowRedirects":true}
