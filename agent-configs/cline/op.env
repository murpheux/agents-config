#!/usr/bin/env bash
# Source (don't execute): `source op.env` — exports OPENAI_API_KEY for Agentgateway from 1Password.
# The key lives only in this shell's environment; nothing is written to disk.
_ref="op://private/agent-gateway-api-key/password"
_key="$(op read "$_ref")" || { echo "op.env: failed to read $_ref" >&2; unset _ref _key; return 1 2>/dev/null || exit 1; }
export OPENAI_API_KEY="$_key"
unset _ref _key
