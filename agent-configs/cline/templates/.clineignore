# .clineignore template (legacy build only; not a security boundary — the guard hook is).
# Copy to a workspace root. Gitignore syntax; `!include .gitignore` pulls in the repo's ignores.
!include .gitignore
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.pfx
*.p12
*.kdbx
*.tfstate
*.tfstate.*
.terraform/
**/secrets/**
*kubeconfig*
node_modules/
bin/
obj/
dist/
.venv/
