{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "agentgateway": {
      "name": "Agentgateway",
      "baseUrl": "https://scarlet:9443/v1",
      "api": "openai-completions",
      "apiKey": "$AGENTGATEWAY_API_KEY",
      "models": [
        { "id": "deepseek-flash", "name": "DeepSeek Flash", "contextWindow": 128000 },
        { "id": "gpt-6.1-sol", "name": "GPT-6.1 Sol", "reasoning": true },
        {
          "id": "claude-sonnet-5-5",
          "name": "Claude Sonnet 5.5",
          "api": "anthropic-messages",
          "baseUrl": "https://scarlet:9443",
          "headers": { "Authorization": "Bearer $AGENTGATEWAY_API_KEY" },
          "reasoning": true,
          "thinkingLevelMap": { "off": null, "minimal": null, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" },
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "compat": { "forceAdaptiveThinking": true, "supportsTemperature": false }
        },
        {
          "id": "claude-opus-5-5",
          "name": "Claude Opus 5.5",
          "api": "anthropic-messages",
          "baseUrl": "https://scarlet:9443",
          "headers": { "Authorization": "Bearer $AGENTGATEWAY_API_KEY" },
          "reasoning": true,
          "thinkingLevelMap": { "off": null, "minimal": null, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max" },
          "input": ["text", "image"],
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "compat": { "forceAdaptiveThinking": true, "supportsTemperature": false }
        }
      ]
    }
  }
}
