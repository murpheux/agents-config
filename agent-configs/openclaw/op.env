# OpenClaw Credential Store Configuration
# Format: op://vault-name/item-name/field-name or use environment variable
#
# These credentials are referenced in openclaw.json via:
#   "source": "store",
#   "provider": "default",
#   "id": "KEY_NAME"
#
# Setup instructions:
# 1. Store each credential in 1Password (or your credential store)
# 2. Reference them by ID in openclaw.json
# 3. Load this file when running OpenClaw:
#    op run --env-file=op.env -- openclaw gateway run

# ─────────────────────────────────────────────────────────────
# PRIMARY GATEWAY: Agentgateway
# ─────────────────────────────────────────────────────────────

export AGENTGATEWAY_TOKEN="op://Personal/OpenClaw/agentgateway-token"
# Alternatively, set directly:
# export AGENTGATEWAY_TOKEN="your-agentgateway-token-here"

# ─────────────────────────────────────────────────────────────
# MODEL PROVIDERS
# ─────────────────────────────────────────────────────────────

# Anthropic API Key (for direct access, fallback to agentgateway)
export ANTHROPIC_API_KEY="op://Personal/Anthropic/api-key"

# DeepSeek API Key (for direct access, fallback to agentgateway)
export DEEPSEEK_API_KEY="op://Personal/DeepSeek/api-key"

# Google API Key (for direct access, fallback to agentgateway)
export GOOGLE_API_KEY="op://Personal/Google/api-key"

# ─────────────────────────────────────────────────────────────
# CHAT CHANNEL INTEGRATIONS (optional)
# ─────────────────────────────────────────────────────────────

# Slack
export SLACK_BOT_TOKEN="op://Personal/Slack/bot-token"
export SLACK_APP_TOKEN="op://Personal/Slack/app-token"

# Discord
export DISCORD_BOT_TOKEN="op://Personal/Discord/bot-token"

# Telegram
export TELEGRAM_BOT_TOKEN="op://Personal/Telegram/bot-token"

# ─────────────────────────────────────────────────────────────
# USAGE
# ─────────────────────────────────────────────────────────────
#
# Load and run OpenClaw with credentials:
#   op run --env-file=op.env -- openclaw gateway run
#
# Or set individual credentials:
#   export AGENTGATEWAY_TOKEN=$(op read op://Personal/OpenClaw/agentgateway-token)
#   openclaw gateway run
#
# Or use direct values (development only, not recommended):
#   export AGENTGATEWAY_TOKEN="sk_live_xxxxx..."
#
# ─────────────────────────────────────────────────────────────
