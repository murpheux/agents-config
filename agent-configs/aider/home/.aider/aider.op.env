# ~/.aider/aider.op.env — 1Password secret REFERENCES (not secrets). Used by `op run --env-file`.
# Never name this file ~/.env: aider auto-loads ~/.env with override and would replace the real
# values with these literal op:// strings. Adjust vault/item names to your 1Password layout.
OPENAI_API_KEY=op://AI/agentgateway/credential
OPENROUTER_API_KEY=op://AI/openrouter/credential
