# ~/.aider/aider.op.env — 1Password secret REFERENCES (not secrets). NOT used by the ai*/aider wrappers
# (they op-read the key themselves to keep the TTY); only for non-interactive one-shots:
#   op run --env-file ~/.aider/aider.op.env -- aider --message "…" --yes-always --no-git
# Never name this file ~/.env: aider auto-loads ~/.env with override and would replace the real
# values with these literal op:// strings. Adjust vault/item names to your 1Password layout.
# All models (incl. arch/sec via the gateway's openrouter/* passthrough) use the gateway key.
OPENAI_API_KEY=op://private/agent-gateway-api-key/password
