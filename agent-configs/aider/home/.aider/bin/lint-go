#!/usr/bin/env bash
# aider lint-cmd wrapper for Go: aider appends the changed file's relative path; lint its package.
set -Eeuo pipefail
file="${1:?usage: lint-go <file.go>}"
pkg="./$(dirname -- "$file")"
if command -v golangci-lint >/dev/null 2>&1; then
  exec golangci-lint run "$pkg"
fi
gofmt -l -- "$file" | grep -q . && { echo "gofmt: $file needs formatting"; exit 1; }
exec go vet "$pkg"
