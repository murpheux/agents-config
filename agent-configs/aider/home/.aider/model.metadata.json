{
  // ~/.aider/model.metadata.json — context limits & prices for gateway models (json5).
  // Prices are PLACEHOLDERS in USD per token: replace with your gateway's real rates so /tokens and
  // the per-message cost report are accurate. Limits are conservative (smaller context = cheaper).
  "openai/claude-sonnet-5": {
    "max_input_tokens": 200000, "max_output_tokens": 32000,
    "input_cost_per_token": 3e-06, "output_cost_per_token": 1.5e-05,
    "input_cost_per_token_cache_hit": 3e-07,
    "litellm_provider": "openai", "mode": "chat"
  },
  "openai/deepseek-flash": {
    "max_input_tokens": 128000, "max_output_tokens": 8192,
    "input_cost_per_token": 2.8e-07, "output_cost_per_token": 4.2e-07,
    "litellm_provider": "openai", "mode": "chat"
  }
}
